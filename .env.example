# Copy to .env, then run `phantom init` and `phantom add VAR_NAME`.
# .env should contain Phantom tokens (phm_…), not plaintext secrets.
#
# Variables used by this project (fill as secrets are added):
# EXAMPLE_API_KEY=
#
# App runtime (P5 voice). Not used for hosted MCP OAuth — connect ElevenLabs
# in Cursor Customize → MCP. Add via `phantom add ELEVENLABS_API_KEY`.
# ELEVENLABS_API_KEY=
